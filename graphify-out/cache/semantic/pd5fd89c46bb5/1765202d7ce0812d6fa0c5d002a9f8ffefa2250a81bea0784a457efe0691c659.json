{"nodes": [{"id": "user_guide_user_guide", "label": "User Guide", "file_type": "document", "source_file": "USER-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "user_guide_myrosta", "label": "Myrosta", "file_type": "concept", "source_file": "USER-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the manual roster spreadsheet with a web app: each consultant sees their own shifts, the group self-rosters fairly, leave and swaps are handled with context, and shifts export straight to payroll; data hosted in Australia and syncing live across devices."}, {"id": "user_guide_passwordless_sign_in", "label": "Passwordless Sign In", "file_type": "concept", "source_file": "USER-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 6-digit code by SMS or email with persistent per-device sessions makes login effectively one-time - no password to remember; SMS is the default because hospital mailboxes often block external email."}, {"id": "user_guide_my_shifts", "label": "My Shifts", "file_type": "concept", "source_file": "USER-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "user_guide_self_roster", "label": "Self Roster", "file_type": "concept", "source_file": "USER-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "user_guide_self_roster_methods", "label": "Self Roster Methods", "file_type": "rationale", "source_file": "USER-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cohort waves, snake-draft rotating turns, guarded free-for-all, and auto-draft plus adjust - admin-selectable per cycle so fairness rules and quotas mean the last person to log in still gets a fair go."}, {"id": "user_guide_shift_quota", "label": "Shift Quota", "file_type": "concept", "source_file": "USER-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counted per fortnight by default to match pay; uneven remainders can be placed by staff in whichever fortnight suits."}, {"id": "user_guide_leave_requests", "label": "Leave Requests", "file_type": "concept", "source_file": "USER-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "user_guide_swap_requests", "label": "Swap Requests", "file_type": "concept", "source_file": "USER-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "user_guide_leave_planner", "label": "Leave Planner", "file_type": "concept", "source_file": "USER-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A colour-coded whole-year view of team leave so staff can plan requests likely to be approved."}, {"id": "user_guide_unplanned_leave", "label": "Unplanned Leave", "file_type": "concept", "source_file": "USER-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approving UPL clears the booked shift so the gap is visible for a colleague to pick up as locum cover."}, {"id": "user_guide_shared_computer_mode", "label": "Shared Computer Mode", "file_type": "concept", "source_file": "USER-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A session flagged as shared never persists and auto-signs-out after idle - ward computers stay safe while personal phones stay signed in."}, {"id": "user_guide_collision_proof_booking", "label": "Collision Proof Booking", "file_type": "rationale", "source_file": "USER-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only free slots are shown and a taken slot disappears for everyone instantly, so two people can never book the same shift."}, {"id": "user_guide_calendar_export", "label": "Calendar Export", "file_type": "concept", "source_file": "USER-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One tap pushes shifts with reminders into Apple, Google, Outlook or Teams calendars as a .ics file."}], "edges": [{"source": "user_guide_user_guide", "target": "user_guide_myrosta", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "USER-GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "user_guide_user_guide", "target": "user_guide_passwordless_sign_in", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "USER-GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "user_guide_user_guide", "target": "user_guide_my_shifts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "USER-GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "user_guide_user_guide", "target": "user_guide_self_roster", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "USER-GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "user_guide_user_guide", "target": "user_guide_self_roster_methods", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "USER-GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "user_guide_user_guide", "target": "user_guide_shift_quota", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "USER-GUIDE.md", "source_location": null, "weight": 1.0}, {"sour