{"nodes": [{"id": "phase2_notifications_phase_2_reminders", "label": "Phase 2 Reminders", "file_type": "document", "source_file": "PHASE2-NOTIFICATIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase 1 flips rounds open/closed in-app; Phase 2 adds automatic email (and optional SMS) reminders when a round opens, 24 hours before close, and at close."}, {"id": "phase2_notifications_notify_rounds_function", "label": "notify-rounds Function", "file_type": "code", "source_file": "PHASE2-NOTIFICATIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs every 5 minutes by cron, independent of the in-app flip; server-side flags mark each message sent once, and a compare-and-swap write ensures it never clobbers a booking made at the same moment."}, {"id": "phase2_notifications_notify_shifts_function", "label": "notify-shifts Function", "file_type": "code", "source_file": "PHASE2-NOTIFICATIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Daily you-are-on-tomorrow reminders to each person's personal email or mobile, skipping anyone off or on leave and noting locum shifts; cron is UTC and does not follow daylight saving, so the hour needs nudging for exactness year-round."}, {"id": "phase2_notifications_twilio_messaging", "label": "Twilio Messaging", "file_type": "concept", "source_file": "PHASE2-NOTIFICATIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Twilio Verify (used for OTP) cannot send reminders; SMS reminders need a Messaging sender, which for Australia must be registered - so email reminders ship immediately and SMS is added later."}], "edges": [{"source": "phase2_notifications_phase_2_reminders", "target": "phase2_notifications_notify_rounds_function", "relation":