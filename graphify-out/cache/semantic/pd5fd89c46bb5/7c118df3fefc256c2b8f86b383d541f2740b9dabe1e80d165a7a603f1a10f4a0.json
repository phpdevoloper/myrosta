{"nodes": [{"id": "changelog_changelog", "label": "Changelog", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_capacity_check", "label": "Capacity Check", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Directors enter needed cover, EFT and a realistic away-buffer to get a plain-words feasibility summary; what-ifs never touch the roster, every line of the maths is shown, and it prints a one-page business case."}, {"id": "changelog_multiorg_foundation", "label": "Multiorg Foundation", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One hospital, many staff groups - every data path, the allow-list and the server functions org-scoped, with per-group branding and feature flags; falls back to single-group behaviour until the database migration runs."}, {"id": "changelog_request_conversations", "label": "Request Conversations", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admins can ask a question instead of declining; the private thread stays on the request, closed and kept once decided, and swap partners can join."}, {"id": "changelog_equity_tab", "label": "Equity Tab", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows tough-shift share versus team average (weekends, Mon/Fri PM, on-call, public holidays, locum) so everyone can see who is carrying the tough shifts; admins choose what counts as tough."}, {"id": "changelog_fatigue_rules", "label": "Fatigue Rules", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimum rest between shifts (counting through the on-call end) and max consecutive clinical days, warning or blocking at booking time; off by default, per cycle, admin-overridable with a warning."}, {"id": "changelog_per_cycle_shift_times", "label": "Per Cycle Shift Times", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AM/PM/on-call/CST start and end times are per-cycle settings; booking labels, payroll and RosterOn exports, calendar files, hours and fatigue maths all follow them."}, {"id": "changelog_public_holiday_marking", "label": "Public Holiday Marking", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admins mark a PH from the roster day header or Daily toggle; the badge shows everywhere so staff see it at booking time."}, {"id": "changelog_sync_hardening", "label": "Sync Hardening", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Council-review outcome: concurrent edits from multiple users merge safely so requests, approvals, messages and bookings cannot be lost or resurrected; offline changes recover on next sign-in with an honest will-sync-when-online status."}, {"id": "changelog_demo_sandbox", "label": "Demo Sandbox", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A /demo.html environment with sample data, safe to explore."}], "edges": [{"source": "changelog_changelog", "target": "ch