{"nodes": [{"id": "admin_guide_admin_guide", "label": "Admin Guide", "file_type": "document", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "admin_guide_import_data", "label": "Import Data", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads existing roster, leave planner and EFT spreadsheets as-is, pulling in EFT, hours and employee numbers - no re-keying to adopt the app."}, {"id": "admin_guide_staff_template", "label": "Staff Template", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For departments with no spreadsheets: download, fill and upload the template and Myrosta builds the department."}, {"id": "admin_guide_zones_and_cover", "label": "Zones and Cover", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clinical areas with per-period headcounts plus a minimum and maximum cover floor and ceiling for each day."}, {"id": "admin_guide_per_cycle_settings", "label": "Per Cycle Settings", "file_type": "rationale", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cover, zones, method and quotas apply to the selected cycle only, so changing the next roster never alters a published one; Prepare next cycle copies the current setup as a starting point."}, {"id": "admin_guide_auto_draft", "label": "Auto Draft", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drafts a fair, fully-covered roster to minimum cover in seconds, skipping anyone on leave - good practice is to auto-draft first, eyeball it, then release for self-roster."}, {"id": "admin_guide_round_scheduling", "label": "Round Scheduling", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schedule open and close date-times auto-open and auto-close the round with a countdown banner and in-app notifications; email/SMS reminders are an optional server add-on."}, {"id": "admin_guide_approval_context", "label": "Approval Context", "file_type": "rationale", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows EFT, leave already taken, who else is away and the daily cap so approvals are decided with context; a decision auto-updates roster and leave planner, notifies the person and drafts the confirmation email."}, {"id": "admin_guide_locum_cover", "label": "Locum Cover", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A vacant cell can be assigned with a Locum tick - flagged with an L badge on the roster, a Locum tag in Daily, and Locum in the payroll export."}, {"id": "admin_guide_access_control", "label": "Access Control", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sync allow-list from staff plus admins gates sign-in by email or mobile; idle auto-logout time for shared computers is set here."}, {"id": "admin_guide_make_admin", "label": "Make Admin", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only an existing admin can grant admin rights, and it is enforced by the database; syncing the allow-list never demotes an admin."}, {"id": "admin_guide_alt_email", "label": "Alt Email", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A personal address for anyone whose hospital blocks external mail - they can sign in with either address."}, {"id": "admin_guide_non_clinical_mode", "label": "Non Clinical Mode", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coordinators and clerks who do not work clinical shifts stay off the roster but can still sign in and be made admins."}, {"id": "admin_guide_payroll_export", "label": "Payroll Export", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One click exports every shift with correct times and leave pro-rated by EFT - no re-keying; a custom import template maps columns automatically and all export buttons are admin-only."}, {"id": "admin_guide_rosteron", "label": "RosterOn", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "admin_guide_rosteron_sheet", "label": "RosterOn Sheet", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A two-sheet workbook: a readable roster grouped by Title matching RosterOn's cell format including overnight OC, plus a clean one-row-per-shift data sheet."}, {"id": "admin_guide_audit_log", "label": "Audit Log", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every approval and change is logged - nothing happens off the record; the log answers any query about a change."}, {"id": "admin_guide_fixed_patterns", "label": "Fixed Patterns", "file_type": "concept", "source_file": "ADMIN-GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weekly or fortnightly A/B patterns can be committed (locked); staff changes to a locked pattern require approval; a pattern day left as Any auto is placed by auto-draft in a balanced free zone around fixed-zone pins."}], "edges": [{"source": "admin_guide_admin_guide", "target": "staff_guide_staff_guide", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ADMIN-GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "admin_guide_admin_guide", "target": "user_guide_myrosta", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ADMIN-GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "admin_guide_admin_guide", "target": "admin_guide_import_data", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ADMIN-GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "admin_guide_admin_guide", "target": "admin_guide_staff_template", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ADMIN-GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "admin_guide_admin_guide", "target": "admin_guide_zones_and_cover", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ADMIN-GUIDE.md", "source_location": null, "weight": 1.0}, {"source": "admin_guide_admin_guide", "target": "admin_guide_per_cycle_settings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ADM