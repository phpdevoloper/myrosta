{"nodes": [{"id": "myrosta_jmo_concept_jmo_rostering_concept", "label": "JMO Rostering Concept", "file_type": "document", "source_file": "MYROSTA-JMO-CONCEPT.md", "source_location": null, "source_url": null, "captured_at": "2026-07-07", "author": null, "contributor": null}, {"id": "myrosta_jmo_concept_choice_within_duty", "label": "Choice Within Duty", "file_type": "concept", "source_file": "MYROSTA-JMO-CONCEPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constrained self-rostering for juniors: you cannot choose whether you do your share of nights and weekends - you choose which ones. No Australian hospital offers juniors self-rostering."}, {"id": "myrosta_jmo_concept_establishment_calculator", "label": "Establishment Calculator", "file_type": "concept", "source_file": "MYROSTA-JMO-CONCEPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cover matrix x 7 = weekly demand; 17-22% leave/sick/study buffer converts floor FTE to establishment; deterministic arithmetic powering the director's business case and a buffer-health dial."}, {"id": "myrosta_jmo_concept_open_shift_marketplace", "label": "Open-Shift Marketplace", "file_type": "concept", "source_file": "MYROSTA-JMO-CONCEPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cross-workforce offer/claim (admin-posted open shifts + staff give-aways) replacing the anyone-free-Saturday WhatsApp; CMO-claimed shifts avoid agency locum fees (measurable ROI); fast-follow because sync hardening removed the concurrent-writes blocker."}, {"id": "myrosta_jmo_concept_eba_rule_packs", "label": "EBA Rule Packs", "file_type": "concept", "source_file": "MYROSTA-JMO-CONCEPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hard floors encoded per enterprise agreement with HR sign-off - roster legality only, never pay interpretation; pack #1 = Victorian Doctors-in-Training agreement."}, {"id": "myrosta_jmo_concept_terms_and_rotation_model", "label": "Terms and Rotation Model", "file_type": "concept", "source_file": "MYROSTA-JMO-CONCEPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Term churn is structural (staggered 3-24-month terms never align with 8-week cycles): templates define stable lines, people occupy them for date ranges; changeover = occupant handover, not a re-roster; supersedes the part-cycle from/to roadmap item."}, {"id": "myrosta_jmo_concept_admin_composed_pipeline", "label": "Admin-Composed Pipeline", "file_type": "concept", "source_file": "MYROSTA-JMO-CONCEPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four modes deployed by the admin per grade, per cycle, per stage - control never leaves them; shipped as named presets to guard against the configuration wall."}, {"id": "myrosta_jmo_concept_relief_lines", "label": "Relief Lines", "file_type": "concept", "source_file": "MYROSTA-JMO-CONCEPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1-2 doctors/day rostered as relief absorb sickness first; escalation ladder: relief, under-hours juniors, CMO offer pool, locum, declared gap vs safe minimum."}, {"id": "myrosta_jmo_concept_medical_workforce_unit", "label": "Medical Workforce Unit", "file_type": "concept", "source_file": "MYROSTA-JMO-CONCEPT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The JMO buyer - bigger budget than any consultant group; recruitment angle: our ED lets you choose your shifts."}], "edges": [{"source": "myrosta_jmo_concept_jmo_rostering_concept", "target": "myrosta_jmo_concept_ch