{"nodes": [{"id": "deploy_deployment_guide", "label": "Deployment Guide", "file_type": "document", "source_file": "DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_index_html", "label": "index.html", "file_type": "code", "source_file": "DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The whole app is one self-contained file running entirely in the browser (localStorage), so no server is needed to use it and hosting is a drag-and-drop."}, {"id": "deploy_phase_a_hosting", "label": "Phase A Hosting", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static hosting with per-device data - good for a director demo or single-admin use; public Phase A links have no login so only demo or anonymised data belongs there."}, {"id": "deploy_phase_b_multi_user", "label": "Phase B Multi User", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browsers cannot share localStorage, so true multi-user needs a shared database plus login; because all reads and writes already go through load() and save(), wiring the backend was a contained change."}, {"id": "deploy_load_save_data_layer", "label": "Load Save Data Layer", "file_type": "code", "source_file": "DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The two functions load() and save() are the single choke point for all reads and writes - the design decision that made swapping localStorage for Supabase a contained change."}, {"id": "deploy_netlify", "label": "Netlify", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free static hosting; the drop page gives an instant shareable URL and a free account makes it permanent."}, {"id": "deploy_hospital_intranet_hosting", "label": "Hospital Intranet Hosting", "file_type": "concept", "source_file": "DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best for governance - data stays inside the hospital network; recommended for real staff data over public hosting."}, {"id": "deploy_information_governance", "label": "Information Governance", "file_type": "rationale", "source_file": "DEPLOY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roster data includes mobile numbers and leave - personal information - so it must sit behind a login and the hospital's information-governance and IT security rules must be checked first."}], "edges": [{"source": "deploy_deployment_guide", "target": "deploy_index_html", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "deploy_deployment_guide", "target": "deploy_phase_a_hosting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "deploy_deployment_guide", "target": "deploy_phase_b_multi_user", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "deploy_deployment_guide", "target": "deploy_netlify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DEPLOY.md", "source_location": null, "weight": 1.0}, {"source": "deploy_deployment_guide", "target": "deploy_hospital_intranet_hosting", "relation": "references", "confidence": "EXTR