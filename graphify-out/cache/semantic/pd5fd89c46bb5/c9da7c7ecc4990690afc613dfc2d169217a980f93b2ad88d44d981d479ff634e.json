{"nodes": [{"id": "supabase_calendar_calendar_feed_setup", "label": "Calendar Feed Setup", "file_type": "document", "source_file": "SUPABASE-CALENDAR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_calendar_live_calendar_feed", "label": "Live Calendar Feed", "file_type": "concept", "source_file": "SUPABASE-CALENDAR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Staff subscribe once via a personal secret webcal link and roster changes flow into phone calendars automatically; the manual .ics download stays as the instant-snapshot fallback with the same event IDs so the two sources stay consistent."}, {"id": "supabase_calendar_ics_edge_function", "label": "ics Edge Function", "file_type": "code", "source_file": "SUPABASE-CALENDAR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JWT verification must be off because calendar apps fetch with no login headers - the secret token in the URL is the credential; only open, closed or published cycles are returned so drafts never leak, and invalid tokens get a bare 404."}, {"id": "supabase_calendar_calendar_token", "label": "Calendar Token", "file_type": "concept", "source_file": "SUPABASE-CALENDAR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The link is the password: it exposes one person's shifts only (no contact or payroll data); reset kills a leaked URL instantly and is audit-logged; tokens live inside shared roster data - acceptable because colleagues already see the whole roster - and should move to their own table at multi-org time."}], "edges": [{"source": "supabase_calendar_calendar_feed_setup", "target": "supabase_calendar_live_calendar_feed", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SUPABASE-CALENDAR.md", "source_location": null, "weight": 1.0}, {"source": "supabase_calendar_calendar_feed_setup", "target": "supabase_calendar_ics_edge_function", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SUPABASE-CALENDAR.md", "source_location": null, "weight": 1.0}, {"source": "supabase_calendar_calendar_feed_setup", "target": "supabase_calendar_calendar_token", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SUPABASE-CALENDAR.md", "source_location": null, "weight": 1.0}, {"source": "supabase_calendar_ics_edge_function", "target": "supabase_calendar_live_calendar_feed", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SUPABASE-CALENDAR.md", "source_location": null, "weight": 1.0}, {"source": "supabase_calendar_live_calendar_feed", "target": "supabase_calendar_calendar_token", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SUPABASE-CALENDAR.md", "source_location": null, "weight": 1.0}, {"source": "supabase_calendar_live_calendar_feed", "target": "user_guide_calendar_export", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SUPABASE-CALENDAR.md", "source_location": null, "weight": 1.0}, {"source": "supabase_calendar_ics_edge_function", "target": "supabase_org_state_table", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "SUPABASE-CALENDAR.md", "source_location": null, "weight": 1.0}, {"source": "supabase_calendar_calendar_token", "target": "changelog_multiorg_foundation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SUPABASE-CALENDAR.md", "source_location": null, "weight": 1.0}], "hyperedges": []}