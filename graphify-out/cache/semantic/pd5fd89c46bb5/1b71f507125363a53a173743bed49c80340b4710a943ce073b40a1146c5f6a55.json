{"nodes": [{"id": "supabase_supabase_setup_guide", "label": "Supabase Setup Guide", "file_type": "document", "source_file": "SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_supabase", "label": "Supabase", "file_type": "concept", "source_file": "SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hosted database with built-in auth and realtime on a free tier - no server to manage; filling three CLOUD values switches the whole app from local to shared cloud data, and blanking them switches it back."}, {"id": "supabase_org_state_table", "label": "org_state Table", "file_type": "code", "source_file": "SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The entire app state is one JSONB row keyed by org - simple and matching the app's single-document model; the trade-off is that fine-grained admin-vs-staff rules stay app-side, with per-record tables as the known upgrade path."}, {"id": "supabase_roster_members_table", "label": "roster_members Table", "file_type": "code", "source_file": "SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The allow-list: only emails or phones on this table can read or write anything even with a valid login; members can read the list, only admins can change it, and a seeded admin bootstraps access."}, {"id": "supabase_rls_policies", "label": "RLS Policies", "file_type": "code", "source_file": "SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SECURITY DEFINER helpers is_member and is_admin_member check the allow-list without recursion; DELETE on org_state was revoked after the 5 Jul 2026 council review because the app never issues it."}, {"id": "supabase_cloud_config", "label": "CLOUD Config", "file_type": "code", "source_file": "SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "url, key, org, adminEmails and allowedDomains bootstrap the app; adminEmails remains the bootstrap so admins cannot be locked out; allowedDomains is a friendly first gate while the allow-list plus RLS is the real enforcement; different org values run separate rosters from one database."}, {"id": "supabase_realtime_sync", "label": "Realtime Sync", "file_type": "concept", "source_file": "SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app loads state on open, saves back debounced, and subscribes to realtime so remote changes refresh automatically - a booking on one device updates everyone."}, {"id": "supabase_otp_email_setup", "label": "OTP Email Setup", "file_type": "concept", "source_file": "SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom SMTP must be connected first because Supabase locks template editing and rate-limits built-in email; the template must include the Token variable or the email only shows a magic link instead of the 6-digit code."}, {"id": "supabase_resend", "label": "Resend", "file_type": "concept", "source_file": "SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as the easiest free SMTP service for sign-in codes, sending as noreply@myrosta.com.au; connecting it unlocks template editing and removes the built-in rate limit."}, {"id": "supabase_twilio_verify", "label": "Twilio Verify", "file_type": "concept", "source_file": "SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen for Australian SMS sign-in because Verify provisions Twilio's own AU-approved sender - an unregistered alphanumeric sender ID fails with Twilio error 21703 and registration takes days; a branded sender is a later nice-to-have."}, {"id": "supabase_sydney_data_residency", "label": "Sydney Data Residency", "file_type": "rationale", "source_file": "SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Region ap-southeast-2 keeps Australian staff data onshore, aligned with the Privacy Act 1988 and the APPs."}, {"id": "supabase_privacy_act_1988", "label": "Privacy Act 1988", "file_type": "concept", "source_file": "SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_compare_and_swap_booking", "label": "Compare and Swap Booking", "file_type": "rationale", "source_file": "SUPABASE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each booking is an atomic compare-and-swap: if the shared record changed since load, the app reloads, re-checks capacity and replays the pick, so simultaneous claims cannot double-book; admin edits use last-write-wins with realtime refresh - fine for a small ED group."}], "edges": [{"source": "supabase_supabase_setup_guide", "target": "supabase_supabase", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SUPABASE.md", "source_location": null, "weight": 1.0}, {"source": "supabase_supabase_setup_guide", "target": "supabase_org_state_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SUPABASE.md", "source_location": null, "weight": 1.0}, {"source": "supabase_supabase_setup_guide", "target": "supabase_roster_members_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SUPABASE.md", "source_locati