{"nodes": [{"id": "graphify_out_converted_self_roster_fairness___option_d_explained_a72fcc65", "label": "Self-roster Fairness - Option D Explained", "file_type": "document", "source_file": "graphify-out/converted/Self-roster Fairness - Option D Explained_a72fcc65.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_self_roster_fairness___option_d_explained_a72fcc65_option_d", "label": "Option D - Points Budget (Bidding)", "file_type": "concept", "source_file": "graphify-out/converted/Self-roster Fairness - Option D Explained_a72fcc65.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sealed bidding lets staff say HOW MUCH a day matters, not just that it matters - a family event can outrank a mild preference. Budget scales with contracted hours (about 1 point per rosterable hour: 76 full-time, 56 at 0.7 EFT) so every EFT holds equal power per shift owed; losing bids are refunded in full; unspent points carry over capped at about 1.5x a cycle budget to prevent hoarding. Runs on the same engine as Option C (sealed week, audited draws, carry-over priority for ties); spending nothing makes it behave exactly like C. Trade-offs: colleagues bid against each other for personal events, it rewards tactical play, losing a heavy bid stings, and it is the hardest option to explain and run. The author's close second choice."}], "edges": [{"source": "graphify_out_converted_self_roster_fairness___option_d_explained_a72fcc65", "target": "graphify_out_converted_self_roster_fairness___option_d_explained_a72fcc65_option_d", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Self-roster Fairness - Option D Explained_a72fcc65.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_self_roster_fairness___option_d_explained_a72fcc65", "target": "