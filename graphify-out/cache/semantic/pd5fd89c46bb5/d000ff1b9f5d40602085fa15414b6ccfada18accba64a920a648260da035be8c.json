{"nodes": [{"id": "graphify_out_converted_myrosta___user_guide_9fe3d291", "label": "Myrosta - User Guide", "file_type": "document", "source_file": "graphify-out/converted/Myrosta - User Guide_9fe3d291.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_myrosta___user_guide_9fe3d291_self_roster_methods", "label": "Self-roster Methods", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - User Guide_9fe3d291.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four configurable round styles - cohort waves, snake-draft (rotating turns), guarded free-for-all, and auto-draft + adjust - all tracking everyone against quota and caps so shifts spread evenly and login order does not decide fair shares. Rounds can be scheduled to auto-open and auto-close with a countdown and notifications."}, {"id": "graphify_out_converted_myrosta___user_guide_9fe3d291_shift_quota", "label": "Shift Quota (Per Fortnight)", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - User Guide_9fe3d291.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each person's EFT-based shift quota is counted per fortnight by default deliberately to match pay periods; a Staff-choose setting lets a consultant whose quota does not divide evenly place the extra shift in whichever fortnight suits, still capped at their total. Quotas are per-cycle and are the fairness backstop in every rostering method."}, {"id": "graphify_out_converted_myrosta___user_guide_9fe3d291_leave_planner", "label": "Leave Planner", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - User Guide_9fe3d291.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Colour-coded year view of the whole team's leave so staff can pick quieter days likelier to be approved, and admins can see who else is away and the daily cap before deciding a request."}, {"id": "graphify_out_converted_myrosta___user_guide_9fe3d291_fixed_patterns", "label": "Fixed Patterns", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - User Guide_9fe3d291.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weekly or fortnightly A/B set patterns can be committed (locked) so staff edits route to the admin for approval instead of changing silently; a fixed-pattern day can set the period and leave the zone as Any (auto) for auto-draft to place in a balanced free zone around fixed-zone pins, flagging clashes."}], "edges": [{"source": "graphify_out_converted_myrosta___user_guide_9fe3d291", "target": "graphify_out_converted_myrosta___ig___it_summary_58d46817_myrosta", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Myrosta - User Guide_9fe3d291.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_myrosta___user_guide_9fe3d291", "target": "graphify_out_converted_myrosta___ig___it_summary_58d46817_passwordless_sign_in", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Myrosta - User Guide_9fe3d291.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_myrosta___user_guide_9fe3d291", "target": "graphify_out_converted_myrosta___ig___it_summary_58d46817_shared_computer_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Myrosta - User Guide_9fe3d291.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_myrosta___user_guide_9fe3d291", "target": "graphify_out_converted_myrosta___user_guide_9fe3d291_self_roster_methods", "relation": "r