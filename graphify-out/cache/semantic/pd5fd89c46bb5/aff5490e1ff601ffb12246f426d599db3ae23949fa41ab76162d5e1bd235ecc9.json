{"nodes": [{"id": "push_marketplace_marketplace_push_guide", "label": "Marketplace Push Guide", "file_type": "document", "source_file": "PUSH-MARKETPLACE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two features shipped together in Aug 2026, both off by default until the admin switches them on; the marketplace needs no server setup, push needs one function and two secrets."}, {"id": "push_marketplace_open_shift_marketplace", "label": "Open Shift Marketplace", "file_type": "concept", "source_file": "PUSH-MARKETPLACE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin broadcasts post-publication gaps and staff can hand shifts back to the group; claims are first-come or admin-approved, pass the same guards as any booking (leave, double-booking, zone, fatigue, quota with optional confirmed over-quota gap fill), are race-safe and audit-logged; fixed shifts cannot be given away and entries auto-expire the day after the shift."}, {"id": "push_marketplace_offer_to_group", "label": "Offer to Group", "file_type": "concept", "source_file": "PUSH-MARKETPLACE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A consultant offers one of their own upcoming shifts back to the group; a colleague's claim transfers the shift automatically."}, {"id": "push_marketplace_phone_push", "label": "Phone Push", "file_type": "concept", "source_file": "PUSH-MARKETPLACE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web Push chosen over a native app because the PWA path covers it; iPhone needs iOS 16.4+ with Home Screen install; the in-app bell keeps working regardless - push is an extra per-phone layer with an unread badge where supported."}, {"id": "push_marketplace_push_send_function", "label": "push-send Function", "file_type": "code", "source_file": "PUSH-MARKETPLACE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The legacy JWT gateway check is turned off because it rejects genuine new-key sign-in tokens; the function verifies the caller's token server-side and matches them against the allow-list itself, and payloads carry only what the bell shows - no phone numbers or payroll data."}, {"id": "push_marketplace_vapid_keys", "label": "VAPID Keys", "file_type": "concept", "source_file": "PUSH-MARKETPLACE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The private key exists only in the function's secrets and a private Desktop file - not in the app or repo - so a visible push endpoint is useless to anyone else; expired subscriptions self-heal and are not pruned server-side because that would need a CAS write-back not worth it at pilot scale."}], "edges": [{"source": "push_marketplace_marketplace_push_guide", "target": "push_marketplace_open_shift_marketplace", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PUSH-MARKETPLACE.md", "source_location": null, "weight": 1.0}, {"source": "push_marketplace_marketplace_push_guide", "target": "push_marketplace_phone_push", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PUSH-MARKETPLACE.md", "source_location": null, "weight": 1.0}, {"source": "push_marketplace_marketplace_push_guide", "target": "push_marketplace_push_send_function", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PUSH-MARKETPLACE.md", "source_location": null, "weight": 1.0}, {"source": "push_marketplace_marketplace_push_guide", "target": "push_marketplace_vapid_keys", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PUSH-MARKETPLAC