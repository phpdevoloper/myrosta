{"nodes": [{"id": "myrosta_department_board_department_board_spec_v2", "label": "Department Board Spec v2", "file_type": "document", "source_file": "MYROSTA-DEPARTMENT-BOARD.md", "source_location": null, "source_url": null, "captured_at": "2026-08-18", "author": null, "contributor": null, "rationale": "v2 supersedes v1: single-row-per-hospital schema could not stop one group overwriting another because Postgres RLS is row-level; v1 also shipped no RLS and a false determinism claim."}, {"id": "myrosta_department_board_department_board", "label": "Department Board", "file_type": "concept", "source_file": "MYROSTA-DEPARTMENT-BOARD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One screen of who is on now across every staff group - turns five rosters into one department; each group publishes a small digest, everyone in the hospital reads all digests; names only, never pay/leave reasons."}, {"id": "myrosta_department_board_board_slice_schema", "label": "Board Slice Schema", "file_type": "concept", "source_file": "MYROSTA-DEPARTMENT-BOARD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per (hospital, org) so row-level security genuinely isolates each group's digest; removes shared-row merge and CAS contention; never reuses the roster's CAS token."}, {"id": "myrosta_department_board_hospitals_registry", "label": "Hospitals Registry", "file_type": "concept", "source_file": "MYROSTA-DEPARTMENT-BOARD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free-text hospital strings split one department into two boards or merge unrelated sites on a typo (cross-hospital disclosure); id registry + FK with server-derived identity fixes it."}, {"id": "myrosta_department_board_deterministic_slice_build", "label": "Deterministic Slice Build", "file_type": "concept", "source_file": "MYROSTA-DEPARTMENT-BOARD.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two synced devices must emit identical bytes or the publish gate loops; buildSlice takes the cycle as argument, avoids per-device state, sorts entries and hash-gates the write."}], "edges": [{"source": "myrosta_department_board_department_board_spec_v2", "target": "myrosta_department_board_department_board", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MYROSTA-DEPARTMENT-BOARD.md", "source_location": null, "weight": 1.0}, {"source": "myrosta_department_board_department_board_spec_v2", "target": "myrosta_department_board_board_slice_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MYROSTA-DEPARTMENT-BOARD.md", "source_location": null, "weight": 1.0}, {"source": "myrosta_department_board_department_board_spec_v2", "target": "myrosta_department_board_hospitals_registry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MYROSTA-DEPARTMENT-BOARD.md", "source_location": null, "weight": 1.0}, {"source": "myrosta_department_board_department_board_spec_v2", "target": "myrosta_department_board_deterministic_slice_build", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MYROSTA-DEPARTMENT-BOARD.md", "source_location": null, "weight": 1.0}, {"source": "myrosta_department_board_board_slice_schema", "target": "myrosta_department_board_department_board", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MYROSTA-DEPARTMENT-BOARD.md", "source_location": null, "weight": 1.0}, {"source": "myrosta_department_board_hospitals_registry", "target": "myrosta_department_board_board_slice_schema", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_fi