{"nodes": [{"id": "myrosta_site2_plan_second_site_multi_group_plan", "label": "Second Site Multi-Group Plan", "file_type": "document", "source_file": "MYROSTA-SITE2-PLAN.md", "source_location": null, "source_url": null, "captured_at": "2026-08-10", "author": null, "contributor": null}, {"id": "myrosta_site2_plan_second_pilot_site", "label": "Second Pilot Site", "file_type": "concept", "source_file": "MYROSTA-SITE2-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five groups = five orgs under one hospital umbrella, not one shared roster (groups never share shifts, quotas or fairness); separate deployments rejected; site's confirmed 10:00-23:00 no-nights pattern puts all five groups on the existing engine in Stage 1, proven on staging 18 Aug."}, {"id": "myrosta_site2_plan_hospital_umbrella", "label": "Hospital Umbrella", "file_type": "concept", "source_file": "MYROSTA-SITE2-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orgs carry a hospital grouping so a super-admin sees all their groups and the picker reads Site - Nurses / JMOs; cheap, makes five orgs feel like one product."}, {"id": "myrosta_site2_plan_roles_as_zones", "label": "Roles as Zones", "file_type": "concept", "source_file": "MYROSTA-SITE2-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A slot is a labelled slot whether it names a room or a job; proven when nurse 2 was refused already-taken Triage while Staff nurse stayed bookable."}, {"id": "myrosta_site2_plan_scribe_shadow_roster", "label": "Scribe Shadow Roster", "file_type": "concept", "source_file": "MYROSTA-SITE2-PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scribes are paired to a consultant's shift, so their roster follows another org's booked slot; small build once the site's consultants are live."}], "edges": [{"source": "myrosta_site2_plan_second_site_multi_group_plan", "target": "myrosta_site2_plan_second_pilot_site", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MYROSTA-SITE2-PLAN.md", "source_location": null, "weight": 1.0}, {"source": "myrosta_site2_plan_second_site_multi_group_plan", "target": "myrosta_site2_plan_hospital_umbrella", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MYROSTA-SITE2-PLAN.md", "source_location": null, "weight": 1.0}, {"source": "myrosta_site2_plan_second_site_multi_group_plan", "target": "myrosta_site2_plan_roles_as_zones", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MYROSTA-SITE2-PLAN.md", "source_location": null, "weight": 1.0}, {"source": "myrosta_site2_plan_second_site_multi_group_plan", "target": "myrosta_site2_plan_scribe_shadow_roster", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MYROSTA-SITE2-PLAN.md", "source_location": null, "weight": 1.0}, {"source": "myrosta_site2_plan_second_site_multi_group_plan", "target": "myrosta_multiorg_build_multi_org_build_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MYROSTA-SITE2-PLAN.md", "source_location": null, "weight": 1.0}, {"source": "myrosta_site2_plan_second_site_multi_group_plan", "target": "myrosta_shift_templates_plan_shift_templates_phase_2_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MYROSTA-SITE2-PLAN.md", "source_location": null, "weight": 1.0}, {"source": "myrosta_site2_plan_second_site_multi_group_plan", "target": "myrosta_jmo_concept_jmo_rostering_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MYROSTA-SITE2-PLAN.md", "source_location": null, "weight"