{"nodes": [{"id": "graphify_out_converted_myrosta___ig___it_summary_58d46817", "label": "Myrosta - IG & IT Summary", "file_type": "document", "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Dr Ranjith Kandavelu", "contributor": null}, {"id": "graphify_out_converted_myrosta___ig___it_summary_58d46817_myrosta", "label": "Myrosta", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bespoke in-house web app built by an ED consultant to replace a manually maintained 56-column Excel roster: one place to see your own shifts, self-roster fairly, request leave and swaps, and export straight to payroll. A single self-contained HTML/JavaScript page with a local mode (browser-only) and a shared mode (hosted database, live sync, individual logins). Holds no patient or clinical data by design; processes staff personal information only and is intended to comply with the Privacy Act 1988 (Cth) and the APPs."}, {"id": "graphify_out_converted_myrosta___ig___it_summary_58d46817_dr_ranjith_kandavelu", "label": "Dr Ranjith Kandavelu", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_myrosta___ig___it_summary_58d46817_supabase", "label": "Supabase", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_myrosta___ig___it_summary_58d46817_netlify", "label": "Netlify", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_myrosta___ig___it_summary_58d46817_resend", "label": "Resend", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_myrosta___ig___it_summary_58d46817_twilio", "label": "Twilio", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_myrosta___ig___it_summary_58d46817_privacy_act_1988", "label": "Privacy Act 1988 (Cth) and APPs", "file_type": "paper", "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_myrosta___ig___it_summary_58d46817_passwordless_sign_in", "label": "Passwordless 6-Digit Code Sign-in", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No passwords by design: a one-time 6-digit code by SMS (Twilio Verify) or email (Resend), then sessions persist per device - effectively a single sign-in with no passwords stored. Codes carry only the number and the recipient's address, never roster data; the SMS path and an optional personal Alt email deliberately work around hospital mail servers that block external email."}, {"id": "graphify_out_converted_myrosta___ig___it_summary_58d46817_shared_computer_mode", "label": "Shared Computer Mode", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ward and shared computers get a this-is-a-shared-computer tick at sign-in: the session lives in session-only storage cleared when the browser closes and auto-logs-out after an admin-set idle timeout, while personal devices stay signed in - balancing one-tap convenience with shared-terminal safety."}, {"id": "graphify_out_converted_myrosta___ig___it_summary_58d46817_allow_list_rls", "label": "Access Allow-list with Row-Level Security", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authorisation is an allow-list of approved emails and mobiles enforced by database row-level security, so even a valid login from an unlisted address is denied with a No access screen; admin rights can only be granted by an existing admin and are enforced by the database. Known limitation flagged for sign-off: fine-grained staff-edit-own-entries rules are enforced in the app, not the database (roster stored as one document); a per-record design is the planned enhancement if higher assurance is needed."}, {"id": "graphify_out_converted_myrosta___ig___it_summary_58d46817_audit_log", "label": "Audit Log", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logs every approval and change so nothing happens off the record - the admin's answer when anyone queries a change, and the direct fix for the old Excel roster's lack of any who-edited-what-and-when trail."}, {"id": "graphify_out_converted_myrosta___ig___it_summary_58d46817_data_residency_sydney", "label": "Australian Data Residency (Sydney)", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Roster data is kept in a single record in a Supabase PostgreSQL database provisioned in Sydney (ap-southeast-2) so staff data stays onshore, aligned with the Privacy Act 1988 and APPs; the only cross-border flow is a transient sign-in code with an email or phone number via Twilio and Resend, switchable to hospital SMTP to keep email onshore if required. HTTPS everywhere and encryption at rest."}], "edges": [{"source": "graphify_out_converted_myrosta___ig___it_summary_58d46817", "target": "graphify_out_converted_myrosta___ig___it_summary_58d46817_myrosta", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_myrosta___ig___it_summary_58d46817", "target": "graphify_out_converted_myrosta___ig___it_summary_58d46817_dr_ranjith_kandavelu", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_myrosta___ig___it_summary_58d46817", "target": "graphify_out_converted_myrosta___ig___it_summary_58d46817_supabase", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_myrosta___ig___it_summary_58d46817", "target": "graphify_out_converted_myrosta___ig___it_summary_58d46817_netlify", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Myrosta - IG & IT Summary_58d46817.md", "source_location": null, "wei