{"nodes": [{"id": "graphify_out_converted_myrosta___admin_guide_c24e882f", "label": "Myrosta - Admin Guide", "file_type": "document", "source_file": "graphify-out/converted/Myrosta - Admin Guide_c24e882f.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_myrosta___admin_guide_c24e882f_rosteron", "label": "RosterOn", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - Admin Guide_c24e882f.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_myrosta___admin_guide_c24e882f_locum_cover", "label": "Locum Cover and Unplanned Leave (UPL)", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - Admin Guide_c24e882f.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sick consultant logs UPL; approving it clears the booked shift leaving a visible gap a colleague can pick up. Ticking Locum cover on the vacant cell flags the shift with a pink L badge on the roster, a Locum tag in Daily, and Locum in the payroll export - so cover on top of the normal roster is visibly counted and paid."}, {"id": "graphify_out_converted_myrosta___admin_guide_c24e882f_payroll_export", "label": "Payroll Export (RosterOn)", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - Admin Guide_c24e882f.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-click export of every shift with correct times (AM, PM, on-call, CST) and leave pro-rated by EFT eliminates re-keying into payroll; uploading the hospital's RosterOn import template maps columns automatically with a chosen date format; a RosterOn sheet button builds a readable Title-grouped roster plus a one-row-per-shift data sheet. All export buttons are admin-only."}, {"id": "graphify_out_converted_myrosta___admin_guide_c24e882f_zones", "label": "Zones (Clinical Areas)", "file_type": "concept", "source_file": "graphify-out/converted/Myrosta - Admin Guide_c24e882f.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin-defined clinical areas with per-period staffing needs, minimum and maximum daily cover, and an extra-slot unlock order (AM and PM together, AM first, or PM first) - extra slots open only once minimum cover is filled. Configured per cycle so changes never alter a published roster."}], "edges": [{"source": "graphify_out_converted_myrosta___admin_guide_c24e882f", "target": "graphify_out_converted_myrosta___ig___it_summary_58d46817_myrosta", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Myrosta - Admin Guide_c24e882f.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_myrosta___admin_guide_c24e882f", "target": "graphify_out_converted_myrosta___user_guide_9fe3d291_self_roster_methods", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Myrosta - Admin Guide_c24e882f.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_myrosta___admin_guide_c24e882f", "target": "graphify_out_converted_myrosta___admin_guide_c24e882f_zones", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Myrosta - Admin Guide_c24e882f.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_myrosta___admin_guide_c24e882f", "target": "graphify_out_converted_myrosta___user_guide_9fe3d291_shift_quota", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Myrosta - Admin Guide_c24e882f.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out