{"nodes": [{"id": "graphify_out_converted_self_roster_fairness___option_a_explained_61f200c3", "label": "Self-roster Fairness - Option A Explained", "file_type": "document", "source_file": "graphify-out/converted/Self-roster Fairness - Option A Explained_61f200c3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_self_roster_fairness___option_a_explained_61f200c3_option_a", "label": "Option A - Open Booking (First Tap Wins)", "file_type": "concept", "source_file": "graphify-out/converted/Self-roster Fairness - Option A Explained_61f200c3.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept on the ballot as the status quo: instant certainty (first tap holds the slot), nothing new to learn, roster fills fast. Trade-offs: speed alone decides contested slots; staff post-nights, on leave or busy at opening pick from leftovers; no memory, so the same quick people win every cycle with no compensation. Its weakness is exactly the race complaint that triggered the fairness review."}], "edges": [{"source": "graphify_out_converted_self_roster_fairness___option_a_explained_61f200c3", "target": "graphify_out_converted_self_roster_fairness___option_a_explained_61f200c3_option_a", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Self-roster Fairness - Option A Explained_61f200c3.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_converted_self_roster_fairness___option_a_explained_61f200c3", "target": "graphify_out_converted_self_roster_fairness___staff_brief_c2c50b92_self_roster_race_problem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Self-roster Fairness - Option A Explained_61f200c3.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_conver