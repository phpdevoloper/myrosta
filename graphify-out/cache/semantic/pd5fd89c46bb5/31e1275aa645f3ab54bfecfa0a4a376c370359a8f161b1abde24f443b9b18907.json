{"nodes": [{"id": "myrosta_trademark_trademark_application_notes", "label": "Trademark Application Notes", "file_type": "document", "source_file": "MYROSTA-TRADEMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "myrosta_trademark_myrosta_word_mark", "label": "MYROSTA Word Mark", "file_type": "concept", "source_file": "MYROSTA-TRADEMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain word mark first for broadest protection, classes 9 + 42; wording kept general (workforce scheduling, not medical) because healthcare-specific wording would narrow protection and might pull in class 44."}, {"id": "myrosta_trademark_tm_headstart", "label": "TM Headstart", "file_type": "concept", "source_file": "MYROSTA-TRADEMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IP Australia pre-assessment route, converting to a full application; each class a separate fee."}, {"id": "myrosta_trademark_rostra_prior_mark", "label": "ROSTRA Prior Mark", "file_type": "concept", "source_file": "MYROSTA-TRADEMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ROSTRA reg. 730142 (automotive cruise-control electronics, class 9) is the mark to watch; Headstart exists to test whether an examiner would cite it despite the different goods."}, {"id": "myrosta_trademark_mustero_rejection", "label": "Mustero Rejection", "file_type": "rationale", "source_file": "MYROSTA-TRADEMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MUSTER is registered bare in classes 9/35 plus a cluster of software Muster marks, making Mustero a high deceptive-similarity risk; Myrosta vs ROSTRA (different word, different goods) is the stronger position."}], "edg