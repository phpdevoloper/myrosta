{"nodes": [{"id": "graphify_out_converted_self_roster_fairness___option_e_explained_1babf21a", "label": "Self-roster Fairness - Option E Explained", "file_type": "document", "source_file": "graphify-out/converted/Self-roster Fairness - Option E Explained_1babf21a.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_out_converted_self_roster_fairness___option_e_explained_1babf21a_option_e", "label": "Option E - Preferences In, Roster Out (Drafted)", "file_type": "concept", "source_file": "graphify-out/converted/Self-roster Fairness - Option E Explained_1babf21a.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asks the least effort: mark days once (same UA budget and prefer-not marks as Option C, plus standing preferences like cluster or spread) and an engine drafts the whole roster in one pass. Hard rules (UA, leave, staffing, safe-hours) are walls, never broken; contested days are decided by two observable facts - who missed the most marked days recently (the same carry-over idea as Option C) and who carries the higher tough-shift share - with losers' ledgers credited so compensation is built in. No race, no draws, nobody visibly loses a head-to-head, and the good-and-bad spread is balanced by design. Trade-offs: you receive a roster rather than choose it, single allocations are harder to explain, least sense of personal control - the computer chose takes trust; a larger undertaking to build."}], "edges": [{"source": "graphify_out_converted_self_roster_fairness___option_e_explained_1babf21a", "target": "graphify_out_converted_self_roster_fairness___option_e_explained_1babf21a_option_e", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Self-roster Fairness - Option E Explained_1babf21a.md", "source_location": null, "weight": 1.0}, {"source": "graphify_out_c